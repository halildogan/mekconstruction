# ─────────────────────────────────────────────────────────────
# MEK Construction website — environment configuration
#
# Copy to .env.local (Docker Compose / local dev) or to the systemd
# EnvironmentFile (see SELF_HOSTING.md). Never commit the real file.
# Every variable is optional: without email credentials, submissions are still
# validated and stored, and the missing configuration is logged.
# ─────────────────────────────────────────────────────────────

# ── Public (inlined into the browser bundle at BUILD time) ───────────────────
# Canonical origin. Must be a public https URL; localhost/private IPs are ignored.
NEXT_PUBLIC_SITE_URL=https://mekdomain.ca

# Analytics: none | plausible | umami (cookieless). Script URL + site id/domain.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Optional Cloudflare Turnstile on forms (set BOTH keys to enable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (server only, read at runtime) ────────────────────────────────────
# console (default: nothing sent, logged only) | resend | smtp
EMAIL_PROVIDER=smtp
# Sender. With Gmail/Workspace SMTP this must be the authenticated mailbox (or an alias of it).
EMAIL_FROM="MEK Construction <no-reply@mekdomain.ca>"

# Resend (https://resend.com) — when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMTP — when EMAIL_PROVIDER=smtp. Gmail / Google Workspace example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<the Gmail address>  SMTP_PASSWORD=<a Google App Password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Internal notification recipients (comma-separated). BID/QUOTE fall back to CONTACT.
CONTACT_EMAIL=
BID_EMAIL=
QUOTE_EMAIL=

# Attach uploaded files to the internal email when their total is below this (MB, max 40).
EMAIL_ATTACHMENT_MAX_MB=10

# ── File storage (server only) ──────────────────────────────────────────────
# local (default) | s3 (Cloudflare R2 or any S3-compatible bucket)
STORAGE_DRIVER=local
# Private directory outside the web root. Docker image default: /app/.data/storage
STORAGE_LOCAL_DIR=

# Cloudflare R2 — when STORAGE_DRIVER=s3 (bucket must stay private)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Lifetime of private download links in internal emails (hours, 0 disables, max 168).
UPLOAD_LINK_TTL_HOURS=72

# ── Runtime ─────────────────────────────────────────────────────────────────
# Port the Node server listens on (Docker image: 9060; systemd example: 3000).
PORT=3000
